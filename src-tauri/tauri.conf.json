{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shogun2 Mod Doctor",
  "version": "0.2.0",
  "identifier": "com.shou2.moddoctor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "幕府将军2 Mod 冲突检测器",
        "width": 1160,
        "height": 780,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
